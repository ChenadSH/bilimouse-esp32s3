# ==== BiliMouse 默认配置 ====

# ---- 目标 ----
CONFIG_IDF_TARGET="esp32s3"

# ---- PSRAM (N16R8: 8MB Octal PSRAM) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_INIT_WITHOUT_RESET=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- 蓝牙 (BLE HID) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_BLE_SMP_ENABLE=y

# ---- 内存分配 ----
CONFIG_HEAP_USE_HOOKS=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- FATFS ----
# IDF v6 的 fatfs 组件默认不带这些 Kconfig 值，需显式声明，
# 否则 ffconf.h 会引用未定义的 CONFIG_FATFS_USE_LABEL 导致编译失败。
CONFIG_FATFS_USE_LABEL=y
CONFIG_FATFS_API_ENCODING_UTF_8=n
CONFIG_FATFS_CODEPAGE=437
CONFIG_FATFS_FAT12=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_LFN_MAX=255
CONFIG_FATFS_MKFS_PERCENT=10
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_VOLUME_LABEL=""
CONFIG_FATFS_IMMEDIATE_FSYNC=n
CONFIG_FATFS_LINK_LOCK=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
CONFIG_FATFS_USE_FASTSEEK=n
CONFIG_FATFS_USE_STRFUNC_NONE=n
CONFIG_FATFS_PRINT_LLI=n
CONFIG_FATFS_PRINT_FLOAT=n
